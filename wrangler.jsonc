{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ambient-forge",
  "compatibility_date": "2026-08-22",
  "main": "worker.mjs",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
